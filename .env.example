# TV30: defaults for a Linux and Docker deployment.
#
# On a new machine:
#   cp .env.example .env
#   ./tv30 up            (Windows: .\tv30.ps1 up)
# ./tv30 up runs docker compose up -d and starts the SSDP announcer (C.3.4)
# outside Docker; ./tv30 down stops it (with ssdp:byebye) before compose
# down. docker compose up -d alone also works, without SSDP discovery.

# Active profiles. Without them, aop, tv3ws, bcast, sysctl-init and mosquitto
# do not start (they all have the "linux" or "mqtt" profile in the compose).
COMPOSE_PROFILES=mqtt,linux

# Images published on Docker Hub. IMAGE_TAG=latest pulls the latest build of
# main.
DOCKERHUB_NS=labmultisens
IMAGE_TAG=latest

# Fixed host ports: 44642 (C.3.4), 44643 (external surface of the edge), the
# AoP port (AOP_PUBLIC_PORT, below), 1883 (MQTT), 6379 (Redis) and the range
# 45000-45199 (remote-device). The others get a free port Docker chooses on
# every container creation; find it with
#   docker compose port <service> <container port>   (or docker compose ps)
# The three variables below go in `ports:` of the service: the number alone
# means a host port chosen by Docker; host:container, a fixed host port.
#
# External surface of the edge (container port 44643), announced by the
# /manifest of tv3ws (Server-SecureBaseURL, EDGE_HTTPS_PORT, default 44643).
# Another host port (e.g. 44743:44643) requires EDGE_HTTPS_PORT=44743 in
# this .env, otherwise the /manifest announces 44643. The number alone means
# a port chosen by Docker, which the /manifest does not announce.
#EDGE_EXT_PUBLISH=44643:44643
#
# bcast (container port 8081). Development with aop on the host needs 8081
# fixed (docs/dev-local.md).
#BCAST_PUBLISH=8081:8081
#
# MQTT over WebSocket of Mosquitto (container port 9001; default: a host port
# chosen by Docker). The TV page does not use this port: it connects to
# ws://<page host>/mqtt, on the AoP port.
#MQTT_WS_PUBLISH=9003:9001
#
# MQTT_WS_PORT is not read by the compose: with aop on the host, it is the
# port where aop reaches the Mosquitto WebSocket (aop/.env.example).

# Broadcaster applications in the graphics layer of the AoP: each one opens
# on its own host name, on the AoP port,
# http://<app>.<APPS_DOMAIN>:<AOP_PUBLIC_PORT>/graphicsAppProxy/... (on the
# host of the application the prefix is optional). <app> is a DNS label
# taken from the appId of the BALD (urn:tv30:app:users-test becomes
# urn-tv30-app-users-test).
#
# Published host port of the AoP, fixed. Default 8080. It also changes the
# origin of the applications; the browser must open the AoP on this port.
#AOP_PUBLIC_PORT=8080
#
# Domain of the applications. Default apps.localhost. *.localhost resolves
# to the machine of whoever opens the page; with the AoP screen opened from
# another machine, the applications do not load. In that case, use a domain
# resolvable on the network, with *.<domain> pointing to the AoP machine
# (wildcard DNS). A value outside [a-z0-9-] labels separated by dots stops
# the AoP at startup.
#APPS_DOMAIN=apps.localhost
#
# /graphicsAppProxy/<path> on the host of the AoP itself (e.g.
# localhost:8080) redirects (302) to the host of the running application,
# and answers 404 without one.

# Variant of the edgegateway (the 44642 and 44643 surfaces serve the same
# route table):
#   linux   = backends by the network DNS (tv3ws); the default deployment
#   windows = backends by host.docker.internal:44654/44655 (tv3ws running on
#             the host with npm run dev; also on Linux, docs/dev-local.md)
EDGE_VARIANT=linux

# Secret and issuer of the accessToken, for tv3ws (which signs) and the edge
# (which validates). Unset, the development default of the compose applies.
# Change it outside the lab.
#JWT_SECRET=troque-este-segredo
#JWT_ISSUER=GenericIssuer

# Credential validation at the edge (tv30-auth plugin):
#   enforce = refuses with 404 and a C.3.2 body (default)
#   warn    = the credential refusals (104, 107, 108) are only logged as
#             "[tv30-auth] WARN" and return the X-TV30-Auth-Warn header
#AUTH_ENFORCE=warn

# Login of the Redis admin UI (redis-commander inside the redis container;
# a host port chosen by Docker: docker port redis 18081). The password
# applies only to that UI: the database connection (6379) has no password.
# Unset or empty, the defaults below apply. Change them outside the lab and
# recreate the container: docker compose up -d redis
#REDIS_COMMANDER_USER=admin
#REDIS_COMMANDER_PASSWORD=tv30-redis-admin

# Host or IP that external devices (on the home network) use to open the
# remote-device WebSockets returned by tv3ws: the IP of the machine as
# reached from outside (e.g. 192.168.1.150). localhost serves only a local
# demo.
SERVER_URL=localhost
# The entry point of the remote device (registration, C.6.15.2) is wss://,
# with the receiver certificate generated in .tv30/tls; the local one
# (C.6.15.5 and the activation by handle) is always ws://. false = ws://
# also for the remote device.
#TV3WS_WS_TLS=false

# SSDP discovery (C.3.4): the announcer runs natively on the host, outside
# Docker, started by ./tv30 up on the three systems. It detects the host of
# LOCATION, the IPv4 of the interface of the default route, and follows
# network changes; the /manifest of tv3ws carries the host by which the
# client reached it.
#   SSDP_ENABLED=false     ./tv30 up does not start the announcer
#   SSDP_ADVERTISE_HOST    override: fixes the host of LOCATION and of the
#                          /manifest (optional)
#   SSDP_INTERFACE         forces the announcing interface (e.g. eth0, en0)
# Read by ./tv30 (announcer) and by tv3ws (/manifest); here they prevail
# over tv3ws/.env.
#SSDP_ENABLED=true
#SSDP_ADVERTISE_HOST=192.168.1.150
#SSDP_INTERFACE=eth0

# webmedia: paths on the remote device (NCL360 player) for media and
# user-files. They depend on the installation of the device; no default.
#WEBMEDIA_REMOTE_MEDIA_PATH=/caminho/no/dispositivo/media/webmedia
#WEBMEDIA_REMOTE_USERFILES_PATH=/caminho/no/dispositivo/user-files
